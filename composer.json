{
    "name": "endurance/route",
    "description": "Routes, immutable content revisions and streaming publication contracts",
    "type": "library",
    "license": "MPL-2.0",
    "require": {
        "php": "^8.5",
        "endurance/foundation": "^0.2.0",
        "endurance/geo": "^0.2.0"
    },
    "autoload": {
        "psr-4": {
            "Endurance\\Route\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Endurance\\Route\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "scripts": {
        "test": "phpunit",
        "example": "@php examples/create-route.php",
        "check": [
            "@composer validate --strict",
            "@test",
            "@example"
        ]
    }
}
