{
    "name": "youmad/endurance-route",
    "description": "Routes, immutable content revisions and streaming publication contracts",
    "type": "library",
    "license": "MPL-2.0",
    "require": {
        "php": "^8.5",
        "youmad/endurance-foundation": "^0.1.2",
        "youmad/endurance-geo": "^0.1.0"
    },
    "autoload": {
        "psr-4": {
            "Youmad\\Endurance\\Route\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Youmad\\Endurance\\Route\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "scripts": {
        "test": "phpunit",
        "example": "@php examples/create-route.php",
        "check": [
            "@composer validate --strict",
            "@test",
            "@example"
        ]
    }
}
